{
  "info": {
    "name": "Restful Booker — QA тестирование",
    "description": "Финальная коллекция для тестового задания QA. Все названия запросов и комментарии на русском.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "firstname",
      "value": "QA Иван"
    },
    {
      "key": "lastname",
      "value": "Тестовый"
    },
    {
      "key": "checkin",
      "value": "2030-01-10"
    },
    {
      "key": "checkout",
      "value": "2030-01-15"
    }
  ],
  "item": [
    {
      "name": "01 — Авторизация: корректные данные",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус ответа 200',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test('Токен присутствует',()=>pm.expect(j.token).to.be.a('string').and.not.empty);",
              "pm.environment.set('token',j.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Авторизация: неверный пароль",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Запрос обработан',()=>pm.expect(pm.response.code).to.be.oneOf([200,400,401,403]));",
              "const j=pm.response.json();",
              "pm.test('Токен не выдан',()=>pm.expect(j.token).to.be.undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Создание бронирования",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 99.99,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус ответа 200',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test('bookingid присутствует',()=>pm.expect(j.bookingid).to.be.a('number'));",
              "pm.environment.set('bookingId',j.bookingid);",
              "pm.test('firstname совпадает',()=>pm.expect(j.booking.firstname).to.eql(pm.environment.get('firstname')));",
              "pm.test('lastname совпадает',()=>pm.expect(j.booking.lastname).to.eql(pm.environment.get('lastname')));",
              "pm.environment.set('checkin',j.booking.bookingdates.checkin);",
              "pm.environment.set('checkout',j.booking.bookingdates.checkout);"
            ]
          }
        }
      ]
    },
